# ---------------------------------------------------------------------------------------------
# Orbital Quarry — environment configuration. Copy to .env for local development.
# Every variable is validated at runtime by src/env.ts (the app refuses to start when invalid).
# Never commit real secrets.
# ---------------------------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------------------------
# Postgres connection string (dev DB; tests use space_mining_test via TEST_DATABASE_URL). In
# production: the restricted runtime role from scripts/sql/app-role.sql, never the owner/migration role.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/space_mining_dev
# Max pooled connections per app instance (default 10).
DATABASE_POOL_MAX=10
# Public base URL of the app (links in emails, auth callbacks).
APP_URL=http://localhost:3002
# Product name shown in the UI. Inlined at BUILD time (rebuild after changing).
NEXT_PUBLIC_APP_NAME="Orbital Quarry"
# Log level: fatal | error | warn | info | debug | trace | silent. Dev logs are pretty-printed
# unless LOG_PRETTY=0.
LOG_LEVEL=info
# Client IP (rate limits, audit log, sessions) — pick the row for your host in docs/DEPLOYMENT.md.
# CLIENT_IP_HEADER: one header your platform sets and clients cannot spoof (Vercel: x-real-ip,
# Fly.io: fly-client-ip, behind Cloudflare: cf-connecting-ip). When set, only that header is used.
CLIENT_IP_HEADER=
# Otherwise: number of proxies in front of the app that append to X-Forwarded-For (Render, Railway,
# Heroku or one nginx: 1; two proxies: 2). The entry that far from the right is the client; anything
# further left is client-controlled. 0 = never trust X-Forwarded-For (no per-IP limits).
TRUSTED_PROXY_HOPS=1

# --- Auth (Better Auth) -----------------------------------------------------------------------
# >= 32 random characters: `openssl rand -hex 32`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32-output-000000
# Optional; defaults to APP_URL.
BETTER_AUTH_URL=
# Sign-in/sign-up/password attempts per minute, counted per client IP and per account (email).
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Background jobs --------------------------------------------------------------------------
# Bearer token for POST /api/cron/<job> (>= 16 chars): `openssl rand -hex 24`.
CRON_SECRET=replace-with-openssl-rand-hex-24-output
# A rig is "silent" after this many minutes without telemetry.
RIG_SILENT_MINUTES=15
# Extra comma-separated recipients for rig alert emails (operators/admins are always included).
OPS_ALERT_EMAILS=

# --- Telemetry --------------------------------------------------------------------------------
# Telemetry POSTs allowed per rig per minute.
TELEMETRY_RATE_LIMIT_PER_MINUTE=120
# Quote requests allowed per customer per hour.
PUBLIC_WRITE_RATE_LIMIT_PER_HOUR=20

# --- Payments (Stripe Invoicing) --------------------------------------------------------------
# stripe | test-bypass. test-bypass fakes invoices for local/dev/test and is REJECTED when
# NODE_ENV=production.
PAYMENTS_MODE=test-bypass
# Secret key (sk_test_… / sk_live_…). Required for PAYMENTS_MODE=stripe.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) for /api/webhooks/stripe (`stripe listen` prints one locally).
STRIPE_WEBHOOK_SECRET=
# ISO currency for invoices.
STRIPE_CURRENCY=usd
# Days a deposit invoice stays open.
INVOICE_DAYS_UNTIL_DUE=14

# --- Email ------------------------------------------------------------------------------------
# SMTP settings. Leave SMTP_HOST empty to log emails instead of sending.
# Local Mailpit (docker compose): SMTP_HOST=localhost SMTP_PORT=1026, UI on http://localhost:8026
SMTP_HOST=
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Orbital Quarry <no-reply@example.com>"

# --- Commercial & model assumptions -------------------------------------------------------------
# Default quote margin (%), quote validity (days) and reservation deposit (% of total).
QUOTE_MARGIN_PERCENT=25
QUOTE_VALIDITY_DAYS=30
DEPOSIT_PERCENT=10
# In-space propellant price used for transport costs (integer cents per kg; 100000 = $1,000/kg).
IN_SPACE_PROPELLANT_COST_PER_KG_CENTS=100000
# Fabrication energy price (integer cents per kWh; 200 = $2/kWh).
FABRICATION_ENERGY_COST_PER_KWH_CENTS=200
# Earth-to-LEO launch price used on the landing page comparison (cents per kg; 250000 = $2,500/kg).
LAUNCH_COST_PER_KG_CENTS=250000

# --- Build / tooling --------------------------------------------------------------------------
# Set to 1 only for `next build` in CI/Docker (placeholders replace missing secrets at build time).
# A production server ignores it (it applies only while NEXT_PHASE=phase-production-build), so it can
# never make a running app use placeholder secrets.
SKIP_ENV_VALIDATION=
# Integration/E2E test database (must contain "test" in its name — it is wiped).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/space_mining_test
# Database used by Playwright (`npm run test:e2e`); also wiped and re-seeded on every run.
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/space_mining_test
# Demo password used by `npm run db:seed` (never in production).
SEED_DEMO_PASSWORD=orbital-demo-2026
